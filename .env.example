APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
DEBUG_ROUTES=false
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=db
DB_USERNAME=db
DB_PASSWORD=db

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Must stay above the embedding job timeout (300 s) so a slow batch is not picked up twice.
# DB_QUEUE_RETRY_AFTER=360

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

OCTANE_SERVER=frankenphp

# AI provider: fake-stream (default, no model needed) or ollama (Ollama on the host)
AI_PROVIDER=fake-stream
# AI_MODEL=
# AI_MAX_TOKENS=400
# AI_TIMEOUT=120
# AI_THINK=false
# AI_FAKE_TOKENS=200
# AI_FAKE_TOKEN_DELAY_MS=50
# AI_FAKE_FAIL_AFTER=
# AI_PROMPT_CAR_DESCRIPTION=car-description.v1
# OLLAMA_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=qwen3.5:9b
# AI_EMBEDDINGS_PROVIDER=ollama
# OLLAMA_EMBED_MODEL=bge-m3
# AI_EMBED_BATCH=256
# AI_EMBED_TIMEOUT=120          # HTTP timeout of one embedding call (seconds), below the job's 300 s
# AI_EF_SEARCH=400              # HNSW candidates per query: higher = better recall, slower
# AI_SEMANTIC_PER_MINUTE=60     # semantic search requests per minute per IP
# AI_DOCS_LARAVEL_REPOSITORY=https://github.com/laravel/docs.git  # git URL docs:fetch-laravel clones
# AI_DOCS_LARAVEL_BRANCH=13.x   # branch of laravel/docs that docs:fetch-laravel clones
# AI_DOCS_CHUNK_MAX_TOKENS=500  # largest docs chunk in estimated tokens; a change re-chunks on the next docs:index
# AI_DOCS_CHUNK_MERGE_BELOW_TOKENS=300  # sections below this size merge into the next one
# AI_DOCS_EMBED_BATCH=32        # chunks per embedding call of docs:index
# AI_DOCS_K_DEFAULT=6           # chunks returned by docs search when k is not given
# AI_DOCS_K_MAX=20              # largest k docs search accepts
# AI_DOCS_RRF_DEPTH=20          # chunks taken from each list before RRF fusion
# AI_DOCS_SEARCH_PER_MINUTE=60  # docs search requests per minute per IP
# AI_DOCS_ANSWER_K=6            # chunks retrieved per docs question
# AI_DOCS_ANSWER_MIN_SIMILARITY=0.5   # cosine similarity a vector-only chunk needs to count as relevant; rag:eval (30 questions) gave TPR 1, FPR 0.17 at 0.5, and no better cut
# AI_DOCS_CACHE_MIN_SIMILARITY=0.94   # cosine a cached question needs to be served; docs:cache-calibrate on 24 paraphrase and 24 near-miss pairs: highest near-miss 0.930409, so 0.94 gives FPR 0 and TPR 0 (the ranges overlap; 24 paraphrases lost)
# AI_DOCS_ANSWER_MAX_CONTEXT_TOKENS=4000  # token budget of the context sent to the model
# AI_DOCS_ANSWER_PER_MINUTE=10  # docs answer requests per minute per IP
# AI_DOCS_ANSWER_GUARD=         # prompt-injection pattern file (default resources/guards/prompt-injection.v1.php)
# OLLAMA_KEEP_ALIVE=10m
# OLLAMA_NUM_PARALLEL=
# OLLAMA_NUM_CTX=8192
# OLLAMA_API_KEY=
