# SL-11: taken over from DDEV (its generated-file marker line is removed on purpose) so that the
# export_offload snippet below survives `ddev restart`.
# Adapted from https://github.com/php/frankenphp/blob/main/caddy/frankenphp/Caddyfile
#
# The Caddyfile is an easy way to configure FrankenPHP and the Caddy web server.
#
# https://frankenphp.dev/docs/config
# https://caddyserver.com/docs/caddyfile
{
	skip_install_trust

	servers {
		trusted_proxies static private_ranges
		metrics
	}

	{$CADDY_GLOBAL_OPTIONS}

	frankenphp {
		{$FRANKENPHP_CONFIG}
	}
}

{$CADDY_EXTRA_CONFIG}

(common_config) {
	root {$DDEV_APPROOT}/{$DDEV_DOCROOT}
	encode zstd br gzip
	{$CADDY_SERVER_EXTRA_DIRECTIVES}

	# DDEV error pages (v1.25.4+) for 403/404 from Caddy itself, PHP responses pass through
	handle_errors 403 404 {
		@ddevErrorPage file {
			root /usr/local/share
			try_files /ddev-webserver-{err.status_code}-error.html
		}
		handle @ddevErrorPage {
			root * /usr/local/share
			rewrite * {file_match.relative}
			header X-Ddev-{err.status_code}-Source "ddev-webserver (frankenphp)"
			file_server
		}
	}
}

# SL-11: PHP answers an export download with an empty body and an absolute path in X-Sendfile.
# Only a path under the exports directory matches; anything else is passed on as PHP sent it. The
# file is then served by a file_server rooted at the exports directory, which cannot leave it.
# The `env EXPORTS_SENDFILE_INTERCEPT 1` lines on the php_server blocks below tell PHP (as a server
# variable) that this Caddyfile intercepts X-Sendfile. The frankenphp-worker Caddyfile and Octane have no
# intercept and do not set it, so there PHP falls back to streaming (App\Services\ExportDeliveryService).
(export_offload) {
	intercept {
		@sendfile header X-Sendfile /var/www/html/storage/app/exports/*
		handle_response @sendfile {
			root * /var/www/html/storage/app/exports
			method * GET
			rewrite * {resp.header.X-Sendfile}
			uri strip_prefix /var/www/html/storage/app/exports
			header -X-Sendfile
			file_server
		}
	}
}

# SL-13: FrankenPHP's built-in Mercure hub. Subscribers are held by the hub, not by PHP workers.
# Caddy reads the keys from process environment variables (untracked .ddev/.env.web, written by
# `artisan mercure:keys`). The hub lives in :80, which the DDEV router reaches and publishers use
# (one unnamed hub is allowed per configuration); :443 proxies the hub path to it so both share one hub.
(mercure_hub) {
	mercure {
		protocol_version_compatibility 8
		publisher_jwt {env.MERCURE_PUBLISHER_JWT_KEY}
		subscriber_jwt {env.MERCURE_SUBSCRIBER_JWT_KEY}
		anonymous
		# A short bolt history (last 100 updates) lets a subscriber that connects just after a publish, or after a
		# dropped connection, replay what it missed (lastEventID=earliest, then Last-Event-ID on reconnect).
		transport bolt {
			path /tmp/mercure.db
			size 100
		}
		cors_origins https://ai-lab.ddev.site
	}
}

:80 {
	import common_config

	@secure header X-Forwarded-Proto https
	route {
		import mercure_hub
		import export_offload

		php_server @secure {
			env EXPORTS_SENDFILE_INTERCEPT 1
			env HTTPS on
			env SERVER_PORT 443
			env REQUEST_SCHEME https
			root {$DDEV_APPROOT}/{$DDEV_DOCROOT}
		}

		php_server {
			env EXPORTS_SENDFILE_INTERCEPT 1
			root {$DDEV_APPROOT}/{$DDEV_DOCROOT}
		}
	}
}

:443 {
	import common_config
	tls /etc/ssl/certs/master.crt /etc/ssl/certs/master.key

	route {
		reverse_proxy /.well-known/mercure* localhost:80 {
			flush_interval -1
		}

		import export_offload

		php_server {
			env EXPORTS_SENDFILE_INTERCEPT 1
			root {$DDEV_APPROOT}/{$DDEV_DOCROOT}
		}
	}
}

# As an alternative to editing the above site block, you can add your own site
# block files in the Caddyfile.d directory, and they will be included as long
# as they use the .caddyfile extension.

import Caddyfile.d/*.caddyfile
