#!/usr/bin/env bash

## Description: Show or switch the web server (frankenphp, frankenphp-worker or frankenphp-octane)
## Usage: server [--current|--url|--default|--check <name>|default|frankenphp|frankenphp-worker|frankenphp-octane]
## Example: ddev server frankenphp
## Example: ddev server default

set -Eeuo pipefail

# Supported servers (SUPPORTED_SERVERS in bench/lib/servers.sh). To add one, append it there and give it a case in overlay_for. A server
# that needs extra files in .ddev/ keeps them in .ddev/servers/<name>/ and lists the ones to
# activate in activated_files. A server may reuse another stash's file or override one of them;
# activated_owner says which stash a file comes from.
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../../../bench/lib/servers.sh
source "$SELF_DIR/../../../bench/lib/servers.sh"
SUPPORTED=("${SUPPORTED_SERVERS[@]}")
# The project's resting server. Scripts ask for it with "ddev server --default" instead of naming it.
DEFAULT_SERVER=frankenphp
APPROOT="${DDEV_APPROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)}"
OVERLAY="$APPROOT/.ddev/config.zz-server.yaml"
STASH="$APPROOT/.ddev/servers"

# Prints the overlay content for a server. The "# server:" marker names the server even
# when several servers share a webserver_type (e.g. generic for FrankenPHP and Octane).
overlay_for() {
  case "$1" in
    frankenphp)
      printf '# server: frankenphp\n'
      cat "$STASH/frankenphp/config.frankenphp.yaml"
      ;;
    frankenphp-octane)
      printf '# server: frankenphp-octane\n'
      cat "$STASH/frankenphp-octane/config.frankenphp-octane.yaml"
      ;;
    frankenphp-worker)
      printf '# server: frankenphp-worker\n'
      cat "$STASH/frankenphp/config.frankenphp.yaml"
      ;;
    *) return 1 ;;
  esac
}

# Prints the URL the active server answers on: the project URL.
base_url_for() {
  echo "https://${DDEV_HOSTNAME:-ai-lab.ddev.site}"
}

# Prints the stash files (relative to .ddev/servers/<name>/ and to .ddev/) a server activates.
activated_files() {
  case "$1" in
    frankenphp | frankenphp-octane | frankenphp-worker)
      printf '%s\n' docker-compose.frankenphp.yaml web-build/Caddyfile.frankenphp \
        web-build/Dockerfile.frankenphp web-build/pre.Dockerfile.frankenphp
      ;;
  esac
}

# Prints the stash a server's activated file comes from: its own, unless it reuses the
# frankenphp files (frankenphp-worker overrides only the Caddyfile).
activated_owner() {
  case "$1:$2" in
    frankenphp-worker:web-build/Caddyfile.frankenphp) echo frankenphp-worker ;;
    frankenphp-octane:* | frankenphp-worker:*) echo frankenphp ;;
    *) echo "$1" ;;
  esac
}

# Deletes files a removed server left in .ddev/ on an older checkout: its activated compose file points at a
# stash that no longer exists, so ddev restart would fail on its missing build context.
remove_removed_leftovers() {
  local server
  for server in "${REMOVED_SERVERS[@]}"; do
    rm -f "$APPROOT/.ddev/docker-compose.$server.yaml"
  done
}

# Deletes the activated files of every server except the given one, and any removed server's leftovers.
deactivate_others() {
  local server file
  remove_removed_leftovers
  for server in "${SUPPORTED[@]}"; do
    [[ "$server" == "$1" ]] && continue
    while IFS= read -r file; do
      [[ -z "$file" ]] || rm -f "$APPROOT/.ddev/$file"
    done < <(activated_files "$server")
  done
}

# Copies the server's activated files from the stash into .ddev/.
activate() {
  local file
  while IFS= read -r file; do
    [[ -z "$file" ]] && continue
    mkdir -p "$(dirname "$APPROOT/.ddev/$file")"
    cp "$STASH/$(activated_owner "$1" "$file")/$file" "$APPROOT/.ddev/$file"
  done < <(activated_files "$1")
}

# Copies every activated file that currently exists into the backup directory.
backup_files() {
  local server file
  for server in "${SUPPORTED[@]}"; do
    while IFS= read -r file; do
      [[ -z "$file" || ! -f "$APPROOT/.ddev/$file" ]] && continue
      mkdir -p "$(dirname "$1/$file")"
      cp "$APPROOT/.ddev/$file" "$1/$file"
    done < <(activated_files "$server")
  done
}

# Removes all activated files, then puts back the ones saved in the backup directory.
restore_files() {
  local server file
  deactivate_others ""
  for server in "${SUPPORTED[@]}"; do
    while IFS= read -r file; do
      [[ -z "$file" || ! -f "$1/$file" ]] && continue
      mkdir -p "$(dirname "$APPROOT/.ddev/$file")"
      cp "$1/$file" "$APPROOT/.ddev/$file"
    done < <(activated_files "$server")
  done
}

# Prints the stash files a server needs as <stash>/<file> (overlay source plus activated files).
stash_files() {
  local file
  case "$1" in
    frankenphp | frankenphp-worker) echo frankenphp/config.frankenphp.yaml ;;
    frankenphp-octane) echo frankenphp-octane/config.frankenphp-octane.yaml ;;
  esac
  while IFS= read -r file; do
    [[ -z "$file" ]] || printf '%s/%s\n' "$(activated_owner "$1" "$file")" "$file"
  done < <(activated_files "$1")
}

# Prints the first <stash>/<file> the server needs that is missing; prints nothing when complete.
missing_stash_file() {
  local file
  while IFS= read -r file; do
    [[ -z "$file" || -f "$STASH/$file" ]] && continue
    printf '%s\n' "$file"
    return
  done < <(stash_files "$1")
}

# Bench overlays (bench/concurrency.sh, timeouts.sh, leaks.sh) tune one server; they must never survive a
# switch, or e.g. an Octane daemon overlay would take over the next server.
bench_overlays() {
  local path
  for path in "$APPROOT"/.ddev/config.zz*-bench-*.yaml "$APPROOT"/.ddev/docker-compose.bench-*.yaml \
    "$APPROOT"/.ddev/web-entrypoint.d/zz-bench-*.sh "$APPROOT"/.ddev/php/zz-bench-*.ini \
    "$APPROOT"/.ddev/bench-concurrency "$APPROOT"/.ddev/bench-timeouts; do
    [[ -e "$path" ]] && printf '%s\n' "$path"
  done
  return 0
}

clear_bench_overlays() {
  local path
  while IFS= read -r path; do
    [[ -z "$path" ]] && continue
    rm -rf "$path"
  done < <(bench_overlays)
}

# True when the overlay and every activated file already match what the server would write.
is_current() {
  local file
  [[ -z "$(bench_overlays)" ]] || return 1
  [[ -f "$OVERLAY" ]] || return 1
  [[ "$(cat "$OVERLAY")" == "$2" ]] || return 1
  while IFS= read -r file; do
    [[ -z "$file" ]] && continue
    cmp -s "$STASH/$(activated_owner "$1" "$file")/$file" "$APPROOT/.ddev/$file" || return 1
  done < <(activated_files "$1")
}

# Prints the server the overlay names, or "not set up" without an overlay. The base config.yaml is only DDEV's bootstrap.
active_server() {
  local name=""
  if [[ -f "$OVERLAY" ]]; then
    name="$(sed -n 's/^# server:[[:space:]]*//p' "$OVERLAY" | head -n 1 | tr -d '[:space:]')"
  fi
  printf '%s\n' "${name:-not set up}"
}

if [[ $# -eq 0 ]]; then
  active="$(active_server)"
  if is_removed_server "$active"; then
    echo "Active: $active (removed; run ddev server default) (default: $DEFAULT_SERVER)"
  else
    echo "Active: $active (default: $DEFAULT_SERVER)"
  fi
  echo "Supported: ${SUPPORTED[*]}"
  [[ -f "$OVERLAY" ]] || echo "Not set up: run ddev setup"
  exit 0
fi

if [[ "$1" == "--default" ]]; then
  echo "$DEFAULT_SERVER"
  exit 0
fi

# --check <name|default>: exit 0 when that server is fully applied (overlay, activated files, no bench overlays), else 1. Changes nothing.
if [[ "$1" == "--check" ]]; then
  check="${2:-}"
  [[ "$check" != "default" ]] || check="$DEFAULT_SERVER"
  [[ -n "$check" && -f "$OVERLAY" && "$(active_server)" == "$check" ]] || exit 1
  content="$(overlay_for "$check")" || exit 1
  is_current "$check" "$content" || exit 1
  exit 0
fi

if [[ "$1" == "--current" ]]; then
  current="$(active_server)"
  if [[ "$current" == "not set up" ]]; then
    echo "not set up (run ddev setup)"
  elif is_removed_server "$current"; then
    echo "$current (removed; run ddev server default)"
  else
    echo "$current"
  fi
  exit 0
fi

if [[ "$1" == "--url" ]]; then
  base_url_for "$(active_server)"
  exit 0
fi

target="$1"
[[ "$target" == "default" ]] && target="$DEFAULT_SERVER"
if is_removed_server "$target"; then
  server_removed_message "$target" >&2
  exit 1
fi
known=0
for server in "${SUPPORTED[@]}"; do
  [[ "$server" == "$target" ]] && known=1
done
if [[ $known -ne 1 ]]; then
  echo "Unknown server '$target'. Supported: ${SUPPORTED[*]}" >&2
  exit 1
fi

missing="$(missing_stash_file "$target")"
if [[ -n "$missing" ]]; then
  echo "The $target stash is incomplete: .ddev/servers/$missing is missing. Restore it with 'git checkout -- .ddev/servers/${missing%%/*}'. Nothing was changed." >&2
  exit 1
fi
content="$(overlay_for "$target")"

if [[ "$target" == "$(active_server)" ]]; then
  if is_current "$target" "$content"; then
    echo "$target already active"
    exit 0
  fi
  echo "$target is active but its files are missing or out of date; re-applying them."
fi

FILES_BACKUP="$(mktemp -d)"
backup_files "$FILES_BACKUP"
BACKUP=""
if [[ -f "$OVERLAY" ]]; then
  BACKUP="$(mktemp)"
  cp "$OVERLAY" "$BACKUP"
fi

# Puts back the overlay and activated files saved above, then removes the temp copies.
restore_previous() {
  if [[ -n "$BACKUP" ]]; then
    cp "$BACKUP" "$OVERLAY"
  else
    rm -f "$OVERLAY"
  fi
  restore_files "$FILES_BACKUP"
  [[ -z "$BACKUP" ]] || rm -f "$BACKUP"
  rm -rf "$FILES_BACKUP"
}

# Any failure or interrupt before the switch completes restores the previous files.
abort_switch() {
  trap - ERR INT TERM
  restore_previous
  echo "Switch to $target aborted; restored the $(active_server) files. Run 'ddev restart' if the project is not running." >&2
  exit 1
}
trap abort_switch ERR INT TERM

clear_bench_overlays
deactivate_others "$target"
activate "$target"
printf '%s\n' "$content" > "$OVERLAY"

if ! ddev restart; then
  trap - ERR INT TERM
  restore_previous
  previous="$(active_server)"
  if ddev restart; then
    echo "ddev restart failed; restored and restarted $previous" >&2
  else
    echo "ddev restart failed; restored the $previous overlay, but the project did not restart. Fix the error above, then run 'ddev restart'." >&2
  fi
  exit 1
fi

trap - ERR INT TERM
[[ -z "$BACKUP" ]] || rm -f "$BACKUP"
rm -rf "$FILES_BACKUP"
echo "Active: $(active_server)"
